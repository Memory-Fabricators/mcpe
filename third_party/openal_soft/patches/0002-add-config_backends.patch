diff --git a/config_backends.h b/config_backends.h
new file mode 100644
index 0000000..3dce8df
--- /dev/null
+++ b/config_backends.h
@@ -0,0 +1,35 @@
+/* Hand-authored config_backends.h for the vendored OpenAL Soft build
+   (normally generated by meson/CMake from config_backends.h.in based on
+   which backend dependencies were found). See
+   //third_party/openal_soft:BUILD.openal.bazel, which compiles exactly one
+   real backend per OS (DirectSound/CoreAudio/ALSA) plus the always-available
+   base/loopback/null/wave backends. */
+#define HAVE_ALSA 0
+#define HAVE_OSS 0
+#define HAVE_PIPEWIRE 0
+#define HAVE_SOLARIS 0
+#define HAVE_SNDIO 0
+#define HAVE_WASAPI 0
+#define HAVE_DSOUND 0
+#define HAVE_WINMM 0
+#define HAVE_PORTAUDIO 0
+#define HAVE_PULSEAUDIO 0
+#define HAVE_JACK 0
+#define HAVE_COREAUDIO 0
+#define HAVE_OPENSL 0
+#define HAVE_OBOE 0
+#define HAVE_OTHERIO 0
+#define HAVE_WAVE 1
+#define HAVE_SDL3 0
+#define HAVE_SDL2 0
+
+#if defined(_WIN32)
+#undef HAVE_DSOUND
+#define HAVE_DSOUND 1
+#elif defined(__APPLE__)
+#undef HAVE_COREAUDIO
+#define HAVE_COREAUDIO 1
+#else
+#undef HAVE_ALSA
+#define HAVE_ALSA 1
+#endif
