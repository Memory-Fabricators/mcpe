# From-source Bazel build of libANGLE (Windows D3D11 backend only), providing
# the GLESv1_CM + EGL libraries this project links against for
# SDL_GL_CreateContext(SDL_GL_CONTEXT_PROFILE_ES). File list transcribed from
# ANGLE's GN manifests at the pinned revision (see
# subprojects/libangle.wrap / subprojects/packagefiles/libangle/meson.build,
# which this mirrors 1:1) -- no GN, Ninja generator, gclient/DEPS submodule
# fetch, or prebuilt ANGLE binary is used. Matches the meson wrap's own
# restriction to the Windows/D3D11 backend; other platforms keep linking
# system GLESv1/EGL (see the ":angle"/default selects in the root
# BUILD.bazel), same as before this port.
#
# Unlike the meson recipe (which lists them unconditionally), the ~30
# OpenCL-GL interop files (libANGLE/CL*.cpp, libGLESv2/cl_*.cpp,
# common/PackedCLEnums_autogen.cpp, etc.) are dropped here: they don't build
# without ANGLE's normal GN-generated include setup, and this project only
# needs GLESv1_CM/EGL windowing/context creation -- no OpenCL interop.
# Nothing outside those files references their symbols.
load("@rules_cc//cc:defs.bzl", "cc_library")

