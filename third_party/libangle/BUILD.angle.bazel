    name = "libangle",
    srcs = _SRCS,
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.inl",
        "src/**/*.h",
        "src/**/*.inc",
    ], allow_empty = True),
    includes = [
        "include",
        "src",
        "src/common/base",
        "src/common/third_party/xxhash",
    ],
    defines = [
        "ANGLE_ENABLE_D3D11",
        "ANGLE_PLATFORM_WINDOWS",
        "ANGLE_STATIC_BUILD",
    ],
    copts = [
        "-D_CRT_SECURE_NO_WARNINGS",
        "-DNOMINMAX",
        # NativeWindow11Win32.cpp needs IDCompositionDevice et al from
        # <dcomp.h>, which are gated behind NTDDI_VERSION >= NTDDI_WIN8
        # (0x06020000); the default target version is lower, which silently
        # compiles those declarations out and leaves incomplete types.
        "-D_WIN32_WINNT=0x0602",
        "-DWINVER=0x0602",
        "-DNTDDI_VERSION=0x06020000",
    ],
    cxxopts = [
        "-std=c++26",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = ["@@//third_party/zlib_google:compression_utils_portable"],
)
