# Minimal from-source Bazel build of SDL3, vendored via the http_archive in
# //MODULE.bazel (same tarball/hash as subprojects/sdl3.wrap).
#
# This project only uses SDL for window creation and OpenGL ES (EGL) context
# management (see handheld/src/main_sdl3.h: SDL_Init(SDL_INIT_VIDEO |
# SDL_INIT_EVENTS), SDL_CreateWindow, SDL_GL_*). It does not use SDL_audio,
# SDL_joystick/gamepad, SDL_haptic, SDL_sensor, SDL_camera, SDL_render,
# SDL_gpu, SDL_dialog, SDL_tray, or SDL_process/storage, so this target
# compiles only: core utilities, events, the real platform video/GL backend,
# and cross-platform "dummy"/disabled stand-ins for the unused subsystems
# (mirroring upstream's own include/build_config/SDL_build_config_minimal.h
# recipe, just swapping video/filesystem/loadso for real backends). This
# keeps the source list and #defines below intentionally small rather than
# porting SDL3's full meson.build (which builds every backend: WASAPI/
# DirectSound, X11/Wayland, hidapi controllers, GPU/render, etc).
#
# SDL_DYNAMIC_API is disabled so the real `SDL_Init` etc. symbols are used
# directly, instead of routing through src/dynapi's runtime trampoline table
# (which requires a generated dispatch file we don't build here).
load("@rules_cc//cc:defs.bzl", "cc_library")

