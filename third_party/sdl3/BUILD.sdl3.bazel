# Subsystems disabled outright (no source files at all, not even a dummy
# backend): joystick/gamepad, haptic, hidapi, sensor. Threads use the real
# per-OS backend (windows/pthread below), not the disabled no-op stub --
# SDL's own video/event internals need real SDL_mutex/SDL_cond primitives
# even though this project never calls SDL_CreateThread itself.
# Mirrors the macros baked into //third_party/sdl3_config:SDL_build_config.h
# (injected as src/SDL_build_config.h by a patch in third_party/sdl3/patches).
# SDL_DYNAMIC_API=0 is repeated here as a compiler -D too since
# SDL_dynapi.h checks SDL_DYNAMIC_API before anything else is included.
_COMMON_DEFINES = [
    "SDL_DYNAMIC_API=0",
]

